# ── Supabase ────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here   # "service_role" secret (NOT anon)

# ── Webhook security ─────────────────────────────────────────────────────────
# Any random string — must match what you send in Zapier/Make as x-webhook-secret
WEBHOOK_SECRET=choose-a-random-secret-string

# ── TikTok API ───────────────────────────────────────────────────────────────
# Get these from: developers.tiktok.com → your app → Manage apps
#
# Step-by-step to get your tokens:
#   1. Go to developers.tiktok.com → create an app
#   2. Enable the "Video List" scope under "Products → Login Kit"
#   3. Use the sandbox or go live, then complete OAuth for your own account
#   4. Copy the access_token, refresh_token, and open_id from the OAuth response
#
TIKTOK_CLIENT_KEY=your-client-key-here            # Also called "App ID" in the dashboard
TIKTOK_CLIENT_SECRET=your-client-secret-here
TIKTOK_ACCESS_TOKEN=your-access-token-here        # Expires every 24h; server auto-refreshes
TIKTOK_REFRESH_TOKEN=your-refresh-token-here      # Used to get a new access token
TIKTOK_OPEN_ID=your-open-id-here                  # Your TikTok user ID (from OAuth response)

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
